<div>
  <h1 class="font-bold text-4xl">Posts#new</h1>
  <p>Find me in app/views/posts/new.html.erb</p>
 <%# This is a new post form.%>
 <%# posts_path == "/posts"%>
  <%= form_with url: posts_path, method: :post do |form| %>
  <div>
    <%= form.label :title%><br>
    <%= form.text_field :title, class: "border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :body %><br>
    <%= form.text_area :body, class: "border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"%>
  </div>

  <div>
    <%= form.submit "Create Post", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
  <% end %>
</div>